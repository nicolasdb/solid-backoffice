# config.ttl — what the backoffice needs to know about a collective.
#
# Upload to https://pod.nicolasdb.eu/hyperscope/config.ttl, then give it
# make it public (docs/how-to/set-up-a-collective.md).
# Field by field: docs/reference/collective-files.md.
#
# <#hyperscope> is the collective's IRI and also its group IRI: members write
# `org:memberOf <https://pod.nicolasdb.eu/hyperscope/config.ttl#hyperscope>`,
# so following that link from a profile leads here.
#
# The hs: namespace is provisional (solid-kit ADR 006, open questions).

@prefix hs:   <https://pod.nicolasdb.eu/hyperscope/vocab#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ldp:  <http://www.w3.org/ns/ldp#> .
@prefix schema: <http://schema.org/> .

<#hyperscope> a hs:Collective, foaf:Group ;
    foaf:name "HyperScope" ;
    # Who the collective recognises. Readable by members only.
    hs:roster <membres.ttl> ;
    ldp:inbox <inbox/> ;
    # The WebID members grant Read to when they share. Never a group.
    hs:agent <agents/agent#me> ;
    # Optional: replace the invited welcome page's title and paragraph
    # (how-to/invite-people.md).
    # schema:slogan "[The collective's title for newcomers]" ;
    # schema:description "[One paragraph: what joining means]" ;
    # Reserved: what a member's profile must contain, as a SHACL shape.
    # hs:requires <member-shape.ttl> ;
    # Created inside each member's pod when they share.
    hs:bundleFolder "output2/hyperscope/" .
