    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@inrupt/solid-client": "^3.0.0",
    "@inrupt/solid-client-authn-browser": "^5.0.0",
    "n3": "^1.26.0"
  }
}
