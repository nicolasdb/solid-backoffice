# Copy to .env (never committed: it is per VPS). No secrets go here.

# Names the compose project and the container (<INSTANCE_NAME>-web).
# Maps of Making: mom-backoffice, one checkout per function with the mom- prefix.
INSTANCE_NAME=mom-backoffice

# The image tag: the same version as the tag this checkout is at
# (git describe --tags). CHANGELOG.md lists them.
BACKOFFICE_VERSION=0.1.0

# This deploy's address, trailing slash included: the Client ID Document
# (/id.jsonld) names it on every consent page.
PUBLIC_URL=https://backoffice.example.org/

# The instance's values and look: the `backoffice/` folder of its vertical's
# design-system repo (solid-kit ADR 011), checked out beside this one.
# COMPOSE_FILE makes Compose load its compose.override.yml after compose.yml;
# DESIGN_SYSTEM is where that repo is (absolute: relative paths resolve from
# this folder). Leave both commented for pod.nicolasdb.eu's values and the
# Solid Kit look.
# COMPOSE_FILE=compose.yml:/srv/mom-design-system/backoffice/compose.override.yml
# DESIGN_SYSTEM=/srv/mom-design-system

# The external Docker network the gateway (Caddy or nginx) is on.
GATEWAY_NETWORK=gateway
